<?xml version="1.0" encoding="utf-8"?>
<application xmlns="http://ns.adobe.com/air/application/3.0">
    <id>com.fun.app</id>
    <versionNumber>1.0.0</versionNumber>
    <versionLabel>1.0</versionLabel>
    <filename>Fun</filename>
    <name>Fun</name>
    <description>A Scratch-like desktop app for creating interactive projects.</description>
    <copyright>2024 Fun Project</copyright>
    
    <initialWindow>
        <content>Fun.swf</content>
        <title>Fun</title>
        <systemChrome>standard</systemChrome>
        <transparent>false</transparent>
        <visible>true</visible>
        <width>1024</width>
        <height>700</height>
        <minSize>800 600</minSize>
        <maxSize>1920 1080</maxSize>
        <x>100</x>
        <y>100</y>
        <resizable>true</resizable>
        <renderMode>gpu</renderMode>
    </initialWindow>
    
    <icon>
        <image16x16>icons/icon16.png</image16x16>
        <image32x32>icons/icon32.png</image32x32>
        <image48x48>icons/icon48.png</image48x48>
        <image128x128>icons/icon128.png</image128x128>
    </icon>
    
    <fileTypes>
        <fileType>
            <name>Fun Project</name>
            <extension>fun</extension>
            <description>Fun Project File</description>
        </fileType>
    </fileTypes>
</application>